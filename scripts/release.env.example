# Copy to release.env (untracked) and fill in.
#
# None of these are secrets. The Team ID is embedded in every Developer ID
# signature and readable from any released build; the repository name is public
# by definition. They live here so the script works for anyone who clones this
# without editing tracked files.
#
# Actual secrets — your Apple ID and its app-specific password — are never
# stored here. They live in the keychain, put there by:
#   xcrun notarytool store-credentials "simpilot" --apple-id … --team-id … --password …

# Ten-character Apple Developer team identifier.
#   security find-identity -v -p codesigning | grep 'Developer ID Application'
TEAM_ID=

# owner/name of the repository whose releases host the DMGs.
GITHUB_REPO=

# Name of the notarytool keychain profile. Defaults to "simpilot".
#NOTARY_PROFILE=simpilot
